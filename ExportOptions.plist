<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- development | ad-hoc | app-store-connect | release-testing | enterprise -->
  <key>method</key>
  <string>development</string>

  <key>signingStyle</key>
  <string>automatic</string>

  <key>teamID</key>
  <string>TEAM_ID</string>   <!-- TODO: 换成你的 10 位 Team ID -->

  <!-- 上架用 app-store-connect / 内测分发用 ad-hoc -->
  <key>manageAppVersionAndBuildNumber</key>
  <false/>

  <!-- 用固定证书/描述文件时改成 manual 并补下面两块
  <key>signingStyle</key><string>manual</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>com.zaloranice.skroutz</key>
    <string>MyApp Development Profile</string>
  </dict>
  -->

  <key>compileBitcode</key>
  <false/>
  <key>stripSwiftSymbols</key>
  <true/>
  <key>uploadSymbols</key>
  <false/>
  <key>destination</key>
  <string>export</string>
</dict>
</plist>
