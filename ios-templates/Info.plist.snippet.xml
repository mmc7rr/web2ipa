<!-- 合进 ios/App/App/Info.plist 顶层 <dict> 内的片段 -->
<key>NSAppTransportSecurity</key>
<dict>
  <!-- 全站 https 时保持 false；要加载 http 或自签证书站才设 true -->
  <key>NSAllowsArbitraryLoads</key>
  <false/>
  <key>NSAllowsLocalNetworking</key>
  <true/>
  <!-- 例外域名示例
  <key>NSExceptionDomains</key>
  <dict>
    <key>zalora-nice.com</key>
    <dict>
      <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
      <key>NSIncludesSubdomains</key><true/>
    </dict>
  </dict>
  -->
</dict>

<key>UIBackgroundModes</key>
<array>
  <string>fetch</string>
</array>

<!-- 壳里调用相机/相册/定位必须补用途字符串，缺了直接闪退 -->
<key>NSCameraUsageDescription</key>
<string>用于扫码与拍照上传</string>
<key>NSPhotoLibraryUsageDescription</key>
<string>用于选择图片上传</string>
<key>NSPhotoLibraryAddUsageDescription</key>
<string>用于保存图片到相册</string>
<key>NSMicrophoneUsageDescription</key>
<string>用于语音输入</string>
<key>NSLocationWhenInUseUsageDescription</key>
<string>用于定位当前城市</string>
<key>ITSAppUsesNonExemptEncryption</key>
<false/>
